# ROXY_CPC_COUNTRY_OF_RESIDENCE_LIMIT=50
# ROXY_CPC_COUNTRY_OF_RESIDENCE_OFFSET=0

# Version-wise archived comparison reports (saved on every run):
#   Roxy_CPC_English_Results/v{version}/{timestamp}/
#   Roxy_CPC_Arabic_Results/v{version}/{timestamp}/
# ROXY_CPC_ENGLISH_RESULTS_DIR=Roxy_CPC_English_Results
# ROXY_CPC_ARABIC_RESULTS_DIR=Roxy_CPC_Arabic_Results
