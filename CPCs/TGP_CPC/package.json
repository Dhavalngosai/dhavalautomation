    "test:arabic-all-fields": "playwright test tests/arabic/country-code-and-nationality.spec.js tests/arabic/country-of-residence.spec.js",
    "test:arabic-all-fields:headed": "playwright test tests/arabic/country-code-and-nationality.spec.js tests/arabic/country-of-residence.spec.js --headed",
    "test:smoke": "playwright test tests/tgp-cpc-update-profile.spec.ts",
    "test:smoke:headed": "playwright test tests/tgp-cpc-update-profile.spec.ts --headed",
    "report": "playwright show-report playwright-report"
