    "test:country-code-and-nationality:headed": "playwright test tests/country-code-and-nationality.spec.js --headed",
    "test:country-of-residence": "playwright test tests/country-of-residence.spec.js",
    "test:country-of-residence:headed": "playwright test tests/country-of-residence.spec.js --headed",
    "test:all-fields": "playwright test tests/country-code-and-nationality.spec.js tests/country-of-residence.spec.js",
    "test:all-fields:headed": "playwright test tests/country-code-and-nationality.spec.js tests/country-of-residence.spec.js --headed",
    "test:arabic-country-code-and-nationality": "playwright test tests/arabic/country-code-and-nationality.spec.js",
    "test:arabic-country-code-and-nationality:headed": "playwright test tests/arabic/country-code-and-nationality.spec.js --headed",
    "test:arabic-country-of-residence": "playwright test tests/arabic/country-of-residence.spec.js",
