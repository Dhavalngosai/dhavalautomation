{
  "name": "rm-cpc-automation",
  "version": "1.0.0",
  "description": "Playwright automation for Real Madrid World CPC (Customer Preference Center)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:ninth25": "playwright test tests/country-code-and-nationality-ninth-25.spec.ts tests/country-of-residence-ninth-25.spec.ts",
    "test:ninth25:headed": "playwright test tests/country-code-and-nationality-ninth-25.spec.ts tests/country-of-residence-ninth-25.spec.ts --headed",
    "test:country-residence-ninth25": "playwright test tests/country-of-residence-ninth-25.spec.ts",
    "test:country-residence-ninth25:headed": "playwright test tests/country-of-residence-ninth-25.spec.ts --headed",
    "test:arabic-ninth25": "playwright test tests/arabic/country-code-and-nationality-ninth-25.spec.ts tests/arabic/country-of-residence-ninth-25.spec.ts",
    "test:arabic-ninth25:headed": "playwright test tests/arabic/country-code-and-nationality-ninth-25.spec.ts tests/arabic/country-of-residence-ninth-25.spec.ts --headed",
    "test:arabic-country-residence-ninth25": "playwright test tests/arabic/country-of-residence-ninth-25.spec.ts",
    "test:arabic-country-residence-ninth25:headed": "playwright test tests/arabic/country-of-residence-ninth-25.spec.ts --headed",
    "report": "playwright show-report playwright-report"
