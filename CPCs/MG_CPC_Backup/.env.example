# Field loop batch: third 50 values by default (items 101–150) for Country code, Nationality, and Country of Residence.

# Each value: select → Save → comparison row (before/after/save/Result).

# End of each field: console.table + comparison-table.html/json in test-results & HTML report.
# Archived copies are also saved under locale-specific version folders:
#   MG_CPC_English_Results/v{version}/{timestamp}/
#   MG_CPC_Arabic_Results/v{version}/{timestamp}/
# MG_CPC_ENGLISH_RESULTS_DIR=MG_CPC_English_Results
# MG_CPC_ARABIC_RESULTS_DIR=MG_CPC_Arabic_Results
# MG_CPC_RESULTS_DIR=  (optional legacy override for both locales)
# MG_CPC_VERSION=1.0.0
# MG_CPC_RUN_TIMESTAMP=2026-07-10_19-16-30
# MG_CPC_ENGLISH_RUN_TIMESTAMP=2026-07-10_19-16-30
# MG_CPC_ARABIC_RUN_TIMESTAMP=2026-07-10_19-16-30

MG_CPC_FIELD_LIMIT=50

MG_CPC_FIELD_OFFSET=100

